+function Replace-ExactOrFail(
+  [string]$Text,
+  [string]$From,
+  [string]$To,
+  [string]$Name
+) {
+  $newLine = if ($Text.Contains("`r`n")) { "`r`n" } else { "`n" }
+  $normalizedText = $Text.Replace("`r`n", "`n").Replace("`r", "`n")
+  $normalizedFrom = $From.Replace("`r`n", "`n").Replace("`r", "`n")
+  $normalizedTo = $To.Replace("`r`n", "`n").Replace("`r", "`n")
+  $changed = $normalizedText.Replace($normalizedFrom, $normalizedTo)
+  if ($changed -ceq $normalizedText) { throw "$Name mutation was a silent no-op" }
+  return $changed.Replace("`n", $newLine)
+}
