 function Replace-InMarkdownSection(
   [string]$Text,
   [string]$SectionName,
   [string]$From,
   [string]$To
 ) {
   $header = "## $SectionName"
   $start = $Text.IndexOf($header, [StringComparison]::Ordinal)
   if ($start -lt 0) { return $Text }
   $next = $Text.IndexOf("`n## ", $start + $header.Length, [StringComparison]::Ordinal)
