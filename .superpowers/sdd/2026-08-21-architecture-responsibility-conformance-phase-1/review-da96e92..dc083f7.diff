           @($evidenceItems | Where-Object { $_ -cnotmatch '^(?:inspection|working-evidence):(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\.(?:md|ps1|dart)(?:#[A-Za-z0-9_.:-]+|:[0-9]+(?:-[0-9]+)?)$' }).Count -gt 0 -or
