+    $body = & $getSection $Text $Heading
+    if ($null -eq $body) { return $null }
+    $lines = @($body -split '\n')
+    $headerIndex = -1
+    for ($lineIndex = 0; $lineIndex -lt $lines.Count; $lineIndex++) {
+      if ($lines[$lineIndex] -match '^\|.*\|[ \t]*$') {
