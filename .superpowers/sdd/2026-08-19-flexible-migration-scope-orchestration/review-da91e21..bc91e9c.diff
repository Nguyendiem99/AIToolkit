+function Assert-Accepted([string]$Name, [string]$Root) {
+  $actual = @(Invoke-AdapterValidation $Root)
+  if ($actual.Count -ne 0) {
+    throw "$Name expected PASS, got: $($actual -join ' || ')"
+  }
+  $script:passed++
